APP_NAME="Srisawan Hybrid Workout"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok
APP_URL=http://localhost

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hybridssw
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GYM_INTERNAL_TRAINER_CODE=

# ตัวเลือกหน้าสมัคร
GYM_REGISTRATION_SHOW_BRANCH=true
GYM_REGISTRATION_VERIFY_IDENTITY=true

# เปิดให้สมัครเป็นเทรนเนอร์ภายในเองหรือไม่
# ปิดไว้ = หน้าสมัครเหลือเฉพาะเทรนเนอร์ภายนอก ส่วนภายในให้แอดมินสร้างให้จากหลังบ้าน
GYM_REGISTRATION_ALLOW_INTERNAL=false

# ขนาดทีมสูงสุดของ Trainer แต่ละประเภท (เว้นว่างไว้ = ไม่จำกัด)
GYM_EXTERNAL_MAX_TEAM=20
GYM_INTERNAL_MAX_TEAM=

# ระบบจอง Private Gym
# ราคา จำนวนคน ระยะจองล่วงหน้า และชั่วโมงสูงสุด ตั้งรายสาขาในหลังบ้าน (เมนูสาขา)
# HOLD_MINUTES = กันเวลาไว้รอชำระเงินกี่นาที
# HOLD_ENDS_AT_START = true ให้หมดเวลาชำระเมื่อถึงเวลาเริ่มด้วย ถ้าจองก่อนเริ่มไม่ถึง HOLD_MINUTES
# NO_TRAINER_RULE = all (ผู้เข้าร่วมทุกคนต้องมีสิทธิ์ไม่มี Trainer) | any (มีคนเดียวก็พอ)
GYM_HOLD_MINUTES=30
GYM_HOLD_ENDS_AT_START=true
GYM_NO_TRAINER_RULE=all

# ชำระเงิน: manual = แอดมินกดบันทึกรับชำระเอง | omise = PromptPay ผ่าน Omise
# ใช้ omise ต้องใส่คีย์ด้วย และตั้ง webhook ใน Omise Dashboard เป็น https://<โดเมน>/webhooks/omise
GYM_PAYMENT_DRIVER=manual
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# ส่งแจ้งเตือนทางอีเมลด้วย (แจ้งในเว็บเสมอ) ต้องตั้งค่า MAIL_* ให้ส่งได้จริง
GYM_NOTIFY_MAIL=true

# ให้คนทั่วไปสมัครสมาชิกเองที่ /register และต้องรอแอดมินอนุมัติก่อนจองได้หรือไม่
GYM_REGISTRATION_PUBLIC=true
GYM_REGISTRATION_APPROVAL=true

# แจ้งเตือนก่อนถึงเวลาจอง
# LEAD = เริ่มเตือนก่อนเริ่มกี่นาที, GRACE = เตือนต่ออีกกี่นาทีหลังเริ่มแล้ว
GYM_REMINDER_LEAD_MINUTES=90
GYM_REMINDER_GRACE_MINUTES=15

# รหัสผ่านของบัญชีตัวอย่างจาก php artisan gym:demo (อย่างน้อย 12 ตัว)
# เว้นว่าง = ระบบสุ่มให้แล้วแสดงครั้งเดียวตอนรันคำสั่ง
DEMO_PASSWORD=

# ใช้ครั้งเดียวตอน deploy ครั้งแรก กับคำสั่ง db:seed --class=ProductionSeeder
# ตั้งรหัสอย่างน้อย 12 ตัวอักษร แล้วลบ ADMIN_PASSWORD ทิ้งหลังสร้างบัญชีเสร็จ
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# ชื่อสาขาแรกที่ ProductionSeeder จะสร้างให้
BRANCH_CODE=MAIN
BRANCH_NAME=
