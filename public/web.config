<?xml version="1.0" encoding="UTF-8"?>
<!--
  ตั้งค่า IIS สำหรับ Laravel — IIS ไม่อ่าน .htaccess ที่อยู่ข้าง ๆ ไฟล์นี้
  ต้องติดตั้ง URL Rewrite Module ของ IIS ก่อน ไม่งั้นทุก URL นอกจากหน้าแรกจะ 500
  วางไว้ใน public/ เท่านั้น และ site root ของ IIS ต้องชี้มาที่ public/ ด้วย
-->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- ตัด / ท้าย URL ทิ้ง ให้เส้นทางมีรูปแบบเดียว -->
                <rule name="Laravel trailing slash" stopProcessing="true">
                    <match url="^(.*)/$" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
                </rule>

                <!-- ไฟล์จริงส่งตรง ที่เหลือโยนเข้า index.php -->
                <rule name="Laravel front controller" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>

        <!-- บีบอัดก่อนส่ง CSS/JS ของหน้าเว็บเล็กลงราว 4-5 เท่า
             ต้องเปิด Windows feature "Static/Dynamic Content Compression" ของ IIS ด้วย ถ้าไม่มี IIS จะข้ามบรรทัดนี้เฉย ๆ -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />

        <!-- ให้หน้า error ของ Laravel แสดงแทนหน้า error ของ IIS -->
        <httpErrors existingResponse="PassThrough" />

        <staticContent>
            <!-- IIS ไม่รู้จักนามสกุลเหล่านี้มาแต่เดิม ฟอนต์กับ manifest จะ 404 ถ้าไม่ประกาศ -->
            <remove fileExtension=".woff" />
            <remove fileExtension=".woff2" />
            <remove fileExtension=".webmanifest" />
            <remove fileExtension=".json" />
            <remove fileExtension=".svg" />
            <mimeMap fileExtension=".woff" mimeType="font/woff" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
        </staticContent>

        <security>
            <requestFiltering>
                <!-- กันไฟล์ที่ไม่ควรถูกเสิร์ฟ เผื่อกรณีที่ root ถูกตั้งผิดที่ -->
                <hiddenSegments>
                    <add segment=".env" />
                    <add segment="storage" />
                    <add segment="vendor" />
                </hiddenSegments>
                <fileExtensions>
                    <add fileExtension=".env" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>
    </system.webServer>

    <!-- ไฟล์ที่ชื่อมีเลขเวอร์ชันฝังอยู่ (build ของ Vite และไฟล์ของ Filament) เปลี่ยนเมื่อไรชื่อก็เปลี่ยน
         ให้เบราว์เซอร์เก็บไว้ได้ทั้งปีโดยไม่ต้องถามเซิร์ฟเวอร์ซ้ำทุกหน้า -->
    <location path="build">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
            </staticContent>
        </system.webServer>
    </location>
    <location path="css/filament">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public" />
            </staticContent>
        </system.webServer>
    </location>
    <location path="js/filament">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public" />
            </staticContent>
        </system.webServer>
    </location>
    <location path="fonts/filament">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public" />
            </staticContent>
        </system.webServer>
    </location>
    <!-- โลโก้และไอคอนชื่อไม่เปลี่ยน เก็บไว้ 7 วันพอ เปลี่ยนรูปแล้วผู้ใช้จะเห็นภายในหนึ่งสัปดาห์ -->
    <location path="img">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" cacheControlCustom="public" />
            </staticContent>
        </system.webServer>
    </location>
</configuration>
